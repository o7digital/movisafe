---
interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en' | 'fr';
  siteUrl?: string;
  canonical?: string;
  availableLocales?: Array<'es' | 'en' | 'fr'>;
}

const {
  title = 'Movisafe',
  description = 'Expertos en seguridad integral',
  lang = 'es',
  siteUrl = 'https://movisafe.com',
  canonical,
  availableLocales = ['es', 'en', 'fr']
} = Astro.props;

const normalizedSiteUrl = siteUrl.replace(/\/$/, '');
const normalizedPathname = (() => {
  const pathname = Astro.url.pathname || '/';
  if (pathname === '/') return pathname;
  return pathname.endsWith('/') ? pathname : `${pathname}/`;
})();

const stripLocalePrefix = (pathname: string) => {
  const segments = pathname.split('/').filter(Boolean);
  if (segments[0] === 'en' || segments[0] === 'fr') {
    const rest = segments.slice(1).join('/');
    return rest ? `/${rest}/` : '/';
  }

  return pathname;
};

const basePath = stripLocalePrefix(normalizedPathname);

const localizedPath = (locale: 'es' | 'en' | 'fr') => {
  if (basePath === '/') {
    return locale === 'es' ? '/' : `/${locale}/`;
  }

  return locale === 'es' ? basePath : `/${locale}${basePath}`;
};

const resolvedCanonical = canonical ?? `${normalizedSiteUrl}${localizedPath(lang)}`;
const alternateLinks = availableLocales.map((locale) => ({
  locale,
  href: `${normalizedSiteUrl}${localizedPath(locale)}`
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:image" content={`${siteUrl}/images/movisafe/capa.webp`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/movisafe/capa.webp`} />

    <link rel="canonical" href={resolvedCanonical} />

    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.locale} href={link.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${normalizedSiteUrl}/`} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VMQ2L9CEE6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-VMQ2L9CEE6');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --mv-blue: #152342;
    --mv-blue-deep: #001d3f;
    --mv-red: #7e272b;
    --mv-light: #f2f2f2;
    --mv-text: #3f3f3f;
    --mv-border: #d4d4d4;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    font-family: 'Lato', Arial, sans-serif;
    color: var(--mv-text);
    background: #ffffff;
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(1140px, calc(100% - 2.25rem));
    margin: 0 auto;
  }
</style>
