---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    kicker: 'Diagnostico',
    title: 'Auditoria de Ciberseguridad',
    text:
      'Evaluacion profesional para identificar vulnerabilidades, validar controles actuales y documentar el nivel de exposicion ante phishing, ransomware, fuga de datos e interrupciones operativas.',
    items: [
      'Revision alineada a NIST CSF',
      'Accesos, correo, red, endpoints y respaldos',
      'Matriz de riesgos por impacto y urgencia',
      'Informe ejecutivo para direccion'
    ]
  },
  {
    kicker: 'Capacitacion',
    title: 'Concienciacion Antiphishing',
    text:
      'Formacion para usuarios, mandos medios y equipos tecnicos con casos reales, sesiones practicas y materiales accionables para reducir el riesgo humano.',
    items: [
      'Phishing, contrasenas, MFA y manejo de informacion',
      'Protocolos para reportar incidentes',
      'Webinars ejecutivos y sesiones por area',
      'Evidencia interna de sensibilizacion'
    ]
  }
];

const process = [
  {
    num: '01',
    title: 'Contexto del negocio',
    text: 'Identificamos sistemas criticos, usuarios clave, sedes, proveedores, datos sensibles y escenarios de mayor impacto.'
  },
  {
    num: '02',
    title: 'Revision tecnica',
    text: 'Validamos controles de identidad, correo, dispositivos, red, nube, respaldos, politicas y respuesta a incidentes.'
  },
  {
    num: '03',
    title: 'Riesgo ejecutivo',
    text: 'Entregamos hallazgos priorizados, nivel de madurez, impacto probable y recomendaciones con responsables sugeridos.'
  },
  {
    num: '04',
    title: 'Plan 30 / 60 / 90',
    text: 'Definimos acciones inmediatas, mejoras estructurales y capacitacion para reducir exposicion tecnica y riesgo humano.'
  }
];

const training = [
  {
    tag: 'Conciencia cyber',
    title: 'Phishing y fraude digital',
    text: 'Correos falsos, enlaces maliciosos, suplantacion de identidad, ingenieria social y estafas por WhatsApp o llamadas.'
  },
  {
    tag: 'Accesos seguros',
    title: 'Contrasenas, MFA y dispositivos',
    text: 'Buenas practicas para proteger cuentas, usar autenticacion multifactor y asegurar laptops, moviles y accesos remotos.'
  },
  {
    tag: 'Operacion segura',
    title: 'Datos, ransomware e incidentes',
    text: 'Manejo de informacion sensible, senales de ransomware, primeros pasos ante una sospecha y reporte oportuno.'
  }
];

const plans = [
  {
    title: 'Diagnostico Express',
    text: 'Para empresas que quieren conocer rapidamente su exposicion.',
    amount: '48h',
    items: ['Entrevista inicial', 'Checklist NIST CSF', 'Reporte ejecutivo breve', 'Prioridades de mejora'],
    featured: false,
    cta: 'Cotizar'
  },
  {
    title: 'Auditoria + Plan',
    text: 'La oferta principal para convertir hallazgos en acciones.',
    amount: '30/60/90',
    items: ['Auditoria de controles', 'Matriz de riesgos', 'Roadmap de correccion', 'Sesion con direccion'],
    featured: true,
    cta: 'Oferta recomendada'
  },
  {
    title: 'Concienciacion Cyber',
    text: 'Capacitacion continua para equipos y areas criticas.',
    amount: 'Cursos',
    items: ['Phishing e ingenieria social', 'MFA y accesos', 'Manejo seguro de datos', 'Reporte de incidentes'],
    featured: false,
    cta: 'Activar capacitacion'
  }
];
---

<Layout
  title="Movisafe Cyber - Auditoria de Ciberseguridad Empresarial en Mexico"
  description="Landing Movisafe Cyber para auditoria de ciberseguridad, diagnostico NIST CSF, matriz de riesgos, plan 30/60/90 y capacitacion contra phishing y ransomware."
>
  <div class="landing-shell">
    <div class="texture"></div>
    <header class="topbar">
      <div class="wrap nav">
        <a class="brand" href="#top" aria-label="Movisafe Cyber">
          <img src="/images/movisafe/Movisafe-logo-1000x348-v1.0.svg" alt="Movisafe" />
          <span>Cyber</span>
        </a>
        <nav id="primary-navigation" class="navlinks" aria-label="Navegacion principal">
          <a href="#servicios">Auditoria</a>
          <a href="#proceso">Proceso</a>
          <a href="#academia">Capacitacion</a>
          <a href="#planes">Planes</a>
          <a href="#contacto">Contacto</a>
        </nav>
        <a class="cta nav-cta" href="#contacto">Agendar diagnostico</a>
        <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-controls="primary-navigation" aria-expanded="false">
          <span></span>
        </button>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <div class="eyebrow"><span></span> Division cyber de Movisafe</div>
            <h1>Descubre tus riesgos digitales antes de que se conviertan en <strong>incidentes.</strong></h1>
            <p class="lead">
              Movisafe Cyber evalua accesos, endpoints, red, correo, respaldos, politicas y respuesta a incidentes para entregar evidencia ejecutiva, prioridades claras y un plan de remediacion accionable en 30 / 60 / 90 dias.
            </p>
            <div class="actions">
              <a class="cta" href="#contacto">Agendar diagnostico</a>
              <a class="cta ghost" href="#servicios">Ver alcance</a>
            </div>
            <div class="trust">
              <div><strong>48h</strong><span>Primer mapa de exposicion</span></div>
              <div><strong>NIST</strong><span>Diagnostico alineado a CSF</span></div>
              <div><strong>CDMX</strong><span>Atencion ejecutiva y remota</span></div>
            </div>
          </div>

          <div class="console" aria-label="Vista de auditoria Movisafe Cyber">
            <div class="screen">
              <div class="screenbar"><span></span><span></span><span></span></div>
              <div class="audit-card main-card">
                <h2>Movisafe Cyber Risk Audit</h2>
                <p>Revision de identidad, correo, dispositivos, red, respaldos, nube, politicas, proveedores y respuesta a incidentes.</p>
                <div class="risk-row"><span>Madurez actual</span><strong>62%</strong></div>
                <div class="meter"><span></span></div>
              </div>
              <div class="audit-card">
                <h3>Hallazgos criticos priorizados</h3>
                <p>MFA incompleto, cuentas compartidas, backups sin prueba, exposicion de correo y baja conciencia ante phishing.</p>
              </div>
              <div class="audit-card">
                <h3>Evidencia para direccion</h3>
                <p>Matriz de riesgo, impacto al negocio, quick wins, responsables sugeridos y roadmap de remediacion.</p>
              </div>
              <div class="floating"><span>Resultado esperado</span><strong>Riesgo visible</strong><p>Decisiones claras para invertir donde hay mas exposicion, no donde hay mas ruido.</p></div>
            </div>
          </div>
        </div>
      </section>

      <section id="servicios">
        <div class="wrap">
          <div class="section-head">
            <h2>Auditoria practica para empresas que necesitan claridad, no alarmismo.</h2>
            <p>Evaluamos la operacion real, traducimos los hallazgos a riesgo de negocio y dejamos un plan que direccion, TI y usuarios pueden ejecutar.</p>
          </div>
          <div class="cards">
            {services.map((service) => (
              <article class="card">
                <span class="card-kicker">{service.kicker}</span>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <div class="list">
                  {service.items.map((item) => <div><span>+</span>{item}</div>)}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="proceso">
        <div class="wrap">
          <div class="section-head">
            <h2>Del diagnostico a la remediacion, sin perder semanas.</h2>
            <p>El proceso esta disenado para obtener evidencia rapido, priorizar lo critico y convertir los hallazgos en acciones medibles.</p>
          </div>
          <div class="process">
            {process.map((step) => (
              <article class="step">
                <div>{step.num}</div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="academia">
        <div class="wrap">
          <div class="section-head">
            <h2>Capacitacion que baja el riesgo donde mas ataques empiezan: las personas.</h2>
            <p>Sesiones practicas para que el equipo detecte enganos, proteja accesos, cuide informacion sensible y reporte a tiempo.</p>
          </div>
          <div class="platform">
            {training.map((item) => (
              <article class="platform-card">
                <span class="tag">{item.tag}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="planes">
        <div class="wrap">
          <div class="section-head">
            <h2>Elige el nivel de profundidad que tu empresa necesita.</h2>
            <p>Desde un diagnostico rapido hasta un programa completo de auditoria, plan de remediacion y concienciacion cyber.</p>
          </div>
          <div class="pricing">
            {plans.map((plan) => (
              <article class={`price ${plan.featured ? 'featured' : ''}`}>
                <h3>{plan.title}</h3>
                <p>{plan.text}</p>
                <div class="amount">{plan.amount}</div>
                <ul>
                  {plan.items.map((item) => <li>{item}</li>)}
                </ul>
                <a class={`cta ${plan.featured ? '' : 'ghost'}`} href="#contacto">{plan.cta}</a>
              </article>
            ))}
          </div>

          <form class="quote" id="cotizador" action="https://formspree.io/f/mdaprrdp" method="post">
            <div>
              <span class="tag">Cotizador express</span>
              <h3>Estima el alcance de tu diagnostico.</h3>
              <p>Obten una referencia rapida segun cantidad de equipos, exposicion digital, sedes y controles actuales. El alcance final se valida en una llamada tecnica.</p>
              <div class="quote-form">
                <label class="field wide" for="devices">
                  Equipos a revisar
                  <div class="range-row">
                    <input id="devices" name="devices" type="range" min="5" max="250" step="5" value="40" />
                    <span class="range-value" id="devicesValue">40</span>
                  </div>
                </label>
                <label class="field" for="exposure">
                  Exposicion
                  <select id="exposure" name="exposure">
                    <option value="1">Baja: oficina y correo</option>
                    <option value="1.18" selected>Media: nube y VPN</option>
                    <option value="1.38">Alta: e-commerce / datos sensibles</option>
                  </select>
                </label>
                <label class="field" for="controls">
                  Controles actuales
                  <select id="controls" name="controls">
                    <option value="1.15">Basicos o sin evidencia</option>
                    <option value="1" selected>Parciales: MFA / backups</option>
                    <option value=".9">Maduros: politicas y monitoreo</option>
                  </select>
                </label>
                <label class="field" for="locations">
                  Sedes
                  <select id="locations" name="locations">
                    <option value="0" selected>1 sede</option>
                    <option value="4500">2 a 3 sedes</option>
                    <option value="8500">4+ sedes</option>
                  </select>
                </label>
                <label class="field" for="training">
                  Agregar capacitacion
                  <select id="training" name="training">
                    <option value="0" selected>No por ahora</option>
                    <option value="8500">Webinar ejecutivo</option>
                    <option value="18000">Webinar + curso grabado</option>
                  </select>
                </label>
              </div>
            </div>

            <div class="quote-result" aria-live="polite">
              <div>
                <span>Diagnostico Express estimado</span>
                <div class="quote-total" id="quoteTotal">$38,000 MXN</div>
                <p id="quoteNote">Referencia antes de IVA. Puede variar por alcance tecnico, accesos y urgencia.</p>
              </div>
              <div class="quote-grid">
                <div><span>Entrega</span><strong id="quoteDelivery">48h</strong></div>
                <div><span>Alcance</span><strong id="quoteScope">PyME</strong></div>
              </div>
              <ul>
                <li id="quoteDevices">40 equipos considerados</li>
                <li id="quoteRisk">Exposicion media con controles parciales</li>
                <li id="quoteAddon">Sin capacitacion adicional</li>
              </ul>
              <div class="quote-contact">
                <label class="field" for="name">Nombre<input id="name" name="name" type="text" autocomplete="name" required /></label>
                <label class="field" for="email">Email<input id="email" name="email" type="email" autocomplete="email" required /></label>
                <label class="field" for="company">Empresa<input id="company" name="company" type="text" autocomplete="organization" /></label>
                <label class="field" for="phone">Telefono<input id="phone" name="phone" type="tel" autocomplete="tel" /></label>
                <label class="field wide" for="message">Notas<textarea id="message" name="message" placeholder="Cuentanos si hay sistemas criticos, sedes o urgencia especial."></textarea></label>
              </div>
              <input type="hidden" name="_subject" value="Cotizacion Movisafe Cyber" />
              <input type="hidden" name="estimated_price" id="estimatedPrice" />
              <input type="hidden" name="delivery" id="deliveryValue" />
              <input type="hidden" name="scope" id="scopeValue" />
              <input type="hidden" name="quote_summary" id="quoteSummary" />
              <button class="cta" type="submit">Enviar datos para propuesta</button>
            </div>
          </form>
        </div>
      </section>

      <section id="contacto">
        <div class="wrap">
          <div class="cta-band">
            <div>
              <h2>Tu empresa esta preparada para el proximo ataque?</h2>
              <p>Agenda una llamada con Movisafe Cyber y recibe una ruta clara para evaluar, corregir y capacitar a tu equipo.</p>
            </div>
            <div class="contact-box">
              <form class="contact-form" action="https://formspree.io/f/mdaprrdp" method="post">
                <input type="hidden" name="_subject" value="Solicitud Movisafe Cyber" />
                <label>Nombre<input name="name" type="text" autocomplete="name" required /></label>
                <label>Email<input name="email" type="email" autocomplete="email" required /></label>
                <label>Telefono<input name="phone" type="tel" autocomplete="tel" required /></label>
                <label>Empresa<input name="company" type="text" autocomplete="organization" /></label>
                <label class="wide">Servicio de interes
                  <select name="service" required>
                    <option value="Diagnostico Express">Diagnostico Express</option>
                    <option value="Auditoria + Plan">Auditoria + Plan</option>
                    <option value="Concienciacion Cyber">Concienciacion Cyber</option>
                    <option value="Otro">Otro</option>
                  </select>
                </label>
                <label class="wide">Mensaje<textarea name="message" placeholder="Cuentanos cuantos equipos tienen, que sistemas criticos usan o que necesitas cotizar."></textarea></label>
                <button class="cta wide" type="submit">Enviar solicitud</button>
              </form>
              <div class="contact-mini">
                <div><strong>Telefono:</strong> +52 1 55 6350 2870</div>
                <div><strong>Email:</strong> contacto@movisafe.com</div>
                <div><strong>Ubicacion:</strong> Ciudad de Mexico</div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <img class="footer-logo" src="/images/movisafe/Movisafe-logo-1000x348-v1.0.svg" alt="Movisafe" />
            <p>Movisafe Cyber extiende la experiencia de Movisafe en seguridad integral hacia riesgos digitales: auditoria, diagnostico ejecutivo, plan de remediacion y capacitacion practica.</p>
          </div>
          <div>
            <h3>Transparencia</h3>
            <a href="/aviso-de-privacidad/">Aviso de privacidad</a>
            <a href="#contacto">Solicitud de propuesta</a>
          </div>
          <div>
            <h3>Servicios</h3>
            <a href="#servicios">Auditorias de ciberseguridad</a>
            <a href="#academia">Formacion y concienciacion</a>
            <a href="#planes">Diagnostico NIST CSF</a>
          </div>
          <div>
            <h3>Contacto</h3>
            <a href="tel:+5215563502870">+52 1 55 6350 2870</a>
            <a href="mailto:contacto@movisafe.com">contacto@movisafe.com</a>
            <span>Ciudad de Mexico</span>
          </div>
        </div>
        <div class="footer-bottom">
          <span>Copyright 2026 - Movisafe Cyber</span>
          <span>servicios de ciberseguridad empresarial Mexico CDMX - auditorias de ciberseguridad - NIST CSF - gestion de riesgos tecnologicos - capacitacion antiphishing</span>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  :global(body) {
    background: #03080d;
  }

  .landing-shell {
    --bg: #03080d;
    --panel: rgba(255, 255, 255, 0.075);
    --panel-strong: rgba(255, 255, 255, 0.11);
    --line: rgba(91, 215, 181, 0.2);
    --text: #f5fff9;
    --muted: #a9beb6;
    --green: #5bd7b5;
    --green-strong: #21b985;
    --cyan: #69c7e8;
    --red: #b8333a;
    --shadow: 0 28px 90px rgba(0, 0, 0, 0.5);
    min-height: 100vh;
    overflow-x: hidden;
    color: var(--text);
    background:
      radial-gradient(circle at 8% 3%, rgba(91, 215, 181, 0.2), transparent 27%),
      radial-gradient(circle at 84% 10%, rgba(184, 51, 58, 0.2), transparent 24%),
      linear-gradient(180deg, #03080d 0%, #08141d 46%, #03080d 100%);
  }

  .landing-shell * {
    box-sizing: border-box;
  }

  .texture {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.16;
    background-image:
      linear-gradient(rgba(91, 215, 181, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(91, 215, 181, 0.12) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  .wrap {
    width: min(1180px, calc(100% - 42px));
    margin: 0 auto;
    position: relative;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(3, 8, 13, 0.76);
    backdrop-filter: blur(22px);
  }

  .nav {
    height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .brand img {
    width: 148px;
    height: auto;
    filter: brightness(0) invert(1);
  }

  .brand span {
    color: var(--green);
    font-size: 13px;
    border-left: 1px solid rgba(255, 255, 255, 0.22);
    padding-left: 12px;
  }

  .navlinks {
    display: flex;
    gap: 24px;
    color: var(--muted);
    font-size: 14px;
  }

  .navlinks a:hover {
    color: #fff;
  }

  .menu-toggle {
    display: none;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .menu-toggle span,
  .menu-toggle span::before,
  .menu-toggle span::after {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 99px;
    background: currentColor;
    content: '';
    position: relative;
  }

  .menu-toggle span::before {
    position: absolute;
    top: -7px;
  }

  .menu-toggle span::after {
    position: absolute;
    top: 7px;
  }

  .menu-open .menu-toggle span {
    background: transparent;
  }

  .menu-open .menu-toggle span::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-open .menu-toggle span::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1px solid rgba(91, 215, 181, 0.45);
    border-radius: 999px;
    background: linear-gradient(135deg, var(--green), var(--green-strong));
    color: #00180c;
    font-weight: 900;
    padding: 14px 20px;
    box-shadow: 0 16px 44px rgba(91, 215, 181, 0.24);
    transition: 0.25s transform, 0.25s box-shadow;
    white-space: nowrap;
  }

  .cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 60px rgba(91, 215, 181, 0.36);
  }

  .ghost {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: none;
  }

  .hero {
    padding: 86px 0 64px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.03fr 0.97fr;
    gap: 54px;
    align-items: center;
  }

  .eyebrow,
  .tag,
  .card-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 13px;
    border: 1px solid rgba(91, 215, 181, 0.24);
    border-radius: 999px;
    background: rgba(91, 215, 181, 0.08);
    color: #c9ffe9;
    font-size: 13px;
    font-weight: 800;
  }

  .eyebrow {
    margin-bottom: 22px;
  }

  .eyebrow span {
    width: 9px;
    height: 9px;
    border-radius: 99px;
    background: var(--green);
    box-shadow: 0 0 0 8px rgba(91, 215, 181, 0.12);
  }

  h1 {
    margin: 0 0 26px;
    font-size: clamp(42px, 6.2vw, 82px);
    line-height: 0.96;
    letter-spacing: -0.06em;
    font-weight: 950;
  }

  h1 strong {
    background: linear-gradient(90deg, #fff 0%, #c9ffe9 44%, #69c7e8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    max-width: 650px;
    margin: 0 0 34px;
    color: #d4e6de;
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.55;
  }

  .actions {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .trust div,
  .quote-grid div {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.055);
    padding: 14px 16px;
    color: var(--muted);
    font-size: 13px;
  }

  .trust strong,
  .quote-grid strong {
    display: block;
    color: #fff;
    font-size: 22px;
    margin-bottom: 2px;
  }

  .console {
    position: relative;
    border: 1px solid rgba(153, 255, 214, 0.22);
    border-radius: 34px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.045)),
