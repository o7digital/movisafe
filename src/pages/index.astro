<script>
  const topbar = document.querySelector('.topbar');
  const menuToggle = document.querySelector('.menu-toggle');
  const navLinks = document.querySelector('#primary-navigation');

  function setMenuOpen(isOpen) {
    topbar?.classList.toggle('menu-open', isOpen);
    menuToggle?.setAttribute('aria-expanded', String(isOpen));
    menuToggle?.setAttribute('aria-label', isOpen ? 'Cerrar menu' : 'Abrir menu');
  }

  menuToggle?.addEventListener('click', () => {
    setMenuOpen(!topbar?.classList.contains('menu-open'));
  });

  navLinks?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) {
      setMenuOpen(false);
    }
  });

  window.addEventListener('resize', () => {
    if (window.matchMedia('(min-width: 941px)').matches) {
      setMenuOpen(false);
    }
  });

  const quoteForm = document.querySelector('#cotizador');
  const devicesValue = document.querySelector('#devicesValue');
  const quoteTotal = document.querySelector('#quoteTotal');
  const quoteDelivery = document.querySelector('#quoteDelivery');
  const quoteScope = document.querySelector('#quoteScope');
  const quoteDevices = document.querySelector('#quoteDevices');
  const quoteRisk = document.querySelector('#quoteRisk');
  const quoteAddon = document.querySelector('#quoteAddon');
  const estimatedPrice = document.querySelector('#estimatedPrice');
  const deliveryValue = document.querySelector('#deliveryValue');
  const scopeValue = document.querySelector('#scopeValue');
  const quoteSummary = document.querySelector('#quoteSummary');

  const formatter = new Intl.NumberFormat('es-MX', {
    style: 'currency',
    currency: 'MXN',
    maximumFractionDigits: 0
  });

  const labels = {
    exposure: {
      1: 'exposicion baja',
      1.18: 'exposicion media',
      1.38: 'exposicion alta'
    },
    controls: {
      1.15: 'controles basicos',
      1: 'controles parciales',
      '.9': 'controles maduros'
    },
    training: {
      0: 'Sin capacitacion adicional',
      8500: 'Incluye webinar ejecutivo',
      18000: 'Incluye webinar y curso grabado'
    }
  };

  function calculateQuote() {
    if (!(quoteForm instanceof HTMLFormElement)) return;

    const data = new FormData(quoteForm);
    const devices = Number(data.get('devices'));
    const exposure = String(data.get('exposure'));
    const controls = String(data.get('controls'));
    const locations = Number(data.get('locations'));
    const training = Number(data.get('training'));
    const deviceBlock = Math.ceil(devices / 25);
    const base = 22000 + deviceBlock * 5200;
    const total = Math.round(((base * Number(exposure) * Number(controls)) + locations + training) / 500) * 500;
    const delivery = devices > 120 || exposure === '1.38' ? '72h' : '48h';
    const scope = devices < 50 ? 'PyME' : devices < 130 ? 'Empresa media' : 'Multiarea';
    const trainingLabel = labels.training[String(training)];
    const summary = `${devices} equipos | ${labels.exposure[exposure]} | ${labels.controls[controls]} | ${trainingLabel}`;

    if (devicesValue) devicesValue.textContent = String(devices);
    if (quoteTotal) quoteTotal.textContent = `${formatter.format(total)} MXN`;
    if (quoteDelivery) quoteDelivery.textContent = delivery;
    if (quoteScope) quoteScope.textContent = scope;
    if (quoteDevices) quoteDevices.textContent = `${devices} equipos considerados`;
    if (quoteRisk) quoteRisk.textContent = `${labels.exposure[exposure]} con ${labels.controls[controls]}`;
    if (quoteAddon) quoteAddon.textContent = trainingLabel;
    if (estimatedPrice instanceof HTMLInputElement) estimatedPrice.value = `${formatter.format(total)} MXN`;
    if (deliveryValue instanceof HTMLInputElement) deliveryValue.value = delivery;
    if (scopeValue instanceof HTMLInputElement) scopeValue.value = scope;
    if (quoteSummary instanceof HTMLInputElement) quoteSummary.value = summary;
  }

  quoteForm?.addEventListener('input', calculateQuote);
  calculateQuote();
</script>
